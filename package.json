{
  "name": "mealmanager",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:node": "node scripts/check-node-version.js",
    "predev": "npm run check:node",
    "prestart": "npm run check:node",
    "pretest": "npm run check:node",
    "pretest:coverage": "npm run check:node",
    "dev": "ts-node-dev --respawn src/server.ts",
    "build": "tsc && cp -r src/public dist/public",
    "start": "node dist/server.js",
    "test": "npm run build && node --test tests/*.test.js",
    "test:coverage": "npm run build && node --test --test-concurrency=1 --experimental-test-coverage tests/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "better-sqlite3": "^13.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
